{
  "name": "tim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "e2e": "playwright test",
    "verificar": "next typegen && tsc --noEmit && eslint && vitest run && next build",
    "db:tipos": "supabase gen types typescript --linked > src/lib/supabase/tipos.ts",
    "datos:prueba": "node scripts/prueba.mjs crear",
    "datos:limpiar": "node scripts/prueba.mjs limpiar",
    "mockup": "node scripts/mockup-landing.mjs",
    "capturas": "node scripts/capturas.mjs",
    "esperar-publicacion": "node scripts/esperar-publicacion.mjs",
    "preparar": "node scripts/preparar.mjs",
    "migrar": "node scripts/migrar.mjs",
    "db:tipos:local": "supabase gen types typescript --local > src/lib/supabase/tipos.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.32.1"
