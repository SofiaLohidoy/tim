# Copiá este archivo a .env.local. En local, los valores de Supabase salen de `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). Solo servidor: saltea la RLS.
SUPABASE_SECRET_KEY=
# URL pública del sitio, para los redirects de login.
NEXT_PUBLIC_SITIO_URL=http://localhost:3001
# 1 cuando Google está configurado en Supabase Auth (ver docs/puesta-en-marcha.md).
NEXT_PUBLIC_GOOGLE_HABILITADO=0
# Sal para el hash de IP del rate limit de la landing. Cualquier string largo.
LANDING_SAL=
# Secreto del cron de salud (Vercel lo manda como Bearer).
CRON_SECRET=
# Clave de las cuentas prueba- (scripts/prueba.mjs). Solo para ensayos y tests.
PRUEBA_CLAVE=prueba-tim-2026
# 1 muestra Actividades (fase B) en la barra del estudiante. En prod se prende después de la hackatón.
NEXT_PUBLIC_ACTIVIDADES=0
